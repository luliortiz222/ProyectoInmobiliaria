@model IEnumerable<ProyectoInmobiliaria.models.Inmueble>
@{
    ViewData["Title"] = "Listado de Inmuebles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Inmuebles</h2>
        
        <a href="/Inmueble/Create" class="btn btn-primary me-2">
            + Nuevo Inmueble
        </a>
        <a href="/Inmueble/PorEstado" class="btn btn-outline-primary me-2">
            Filtrar por estado
        </a>
        <a href="/Inmueble/PorPropietario" class="btn btn-outline-primary me-2">
            Filtrar por propietario
        </a>
        <a href="/Inmueble/MasReservados" class="btn btn-outline-primary me-2">
            Filtrar Más Reservados
        </a>
        <a href="/Inmueble/SinReservas" class="btn btn-outline-primary me-2">
            Filtrar Sin Reservas
        </a>
        <a href="/Inmueble/DisponiblesEntreFechas" class="btn btn-outline-primary me-2">
            Filtrar Disponibles
        </a>

    </div>

    <!-- Buscador -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-9">
                        <label class="form-label fw-semibold">
                            Buscar inmueble
                        </label>

                        <input type="text"
                               name="busqueda"
                               value="@ViewBag.Busqueda"
                               class="form-control"
                               placeholder="Buscar por dirección, propietario o tipo" />
                    </div>

                    <div class="col-md-3">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            <i class="bi bi-search"></i>
                            Buscar
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>
    

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Dirección</th>
                    <th>Cupo</th>
                    <th>Coordenadas</th>
                    <th>Precio / Día</th>
                    <th>Imagen</th>
                    <th>Estado</th>
                    <th>Dueño</th>
                    <th>Tipo de Inmueble</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle"><strong>@item.Direccion</strong></td>
                        
                        
                        <td class="align-middle">@item.Cupo</td>
                        <td class="align-middle">@item.Coordenadas</td>
                        <td class="align-middle">@item.PrecioPorDia</td>
                        
                        <td class="align-middle">
                            @if (!string.IsNullOrEmpty(item.ImagenPortada))
                            {
                                <img src="@item.ImagenPortada"
                                     alt="Imagen del inmueble"
                                     style="width: 100px; height: 70px; object-fit: cover;"
                                     class="rounded" />
                            }
                            else
                            {
                                <span class="text-muted">Sin foto</span>
                            }
                        </td>
                        <td class="align-middle">
                            @if (item.Estado)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Suspendido</span>
                            }
                        </td>
                        
                        <td class="align-middle">@item.Dueño.Nombre @item.Dueño.Apellido</td>
                        <td class="align-middle">@item.Tipo.Nombre</td>
                        
                        
                        <td class="align-middle text-center">
                            <!-- Los botones del CRUD -->
                            <a href="/Inmueble/Edit/@item.IdInmueble" class="btn btn-sm btn-outline-warning" title="Editar">
                                Editar
                            </a>
                            @if (User.IsInRole("Administrador"))
                            {
                                <a href="/Inmueble/Delete/@item.IdInmueble" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                    Borrar
                                </a>
                            }
                            
                            <a href="/Inmueble/Details/@item.IdInmueble" class="btn btn-sm btn-outline-info">Detalles</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    @if (User.IsInRole("Administrador") && ViewBag.TotalPaginas > 1)
    {
        <nav class="mt-3">

            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", new { busqueda = ViewBag.Busqueda, pagina = ViewBag.PaginaActual - 1 })">
                        Anterior
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                        <a class="page-link"
                           href="@Url.Action("Index", new { busqueda = ViewBag.Busqueda, pagina = i })">
                            @i
                        </a>

                    </li>
                }

                <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">

                    <a class="page-link"
                       href="@Url.Action("Index", new { busqueda = ViewBag.Busqueda, pagina = ViewBag.PaginaActual + 1 })">
                        Siguiente
                    </a>

                </li>

            </ul>

        </nav>
    }
</div>
