@model IEnumerable<ProyectoInmobiliaria.models.Inmueble>
@{
    ViewData["Title"] = "Listado de Inmuebles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Inmuebles</h2>
        <a href="/Inmueble/Create" class="btn btn-primary">
            + Nuevo Inmueble
        </a>
    </div>
    

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Dirección</th>
                    <th>Cupo</th>
                    <th>Coordenadas</th>
                    <th>Precio / Día</th>
                    <th>Imagen</th>
                    <th>Estado</th>
                    <th>Dueño</th>
                    <th>Tipo de Inmueble</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="align-middle"><strong>@item.Direccion</strong></td>
                        
                        
                        <td class="align-middle">@item.Cupo</td>
                        <td class="align-middle">@item.Coordenadas</td>
                        <td class="align-middle">@item.PrecioPorDia</td>
                        
                        <td class="aling-middle">
                            @if (!string.IsNullOrEmpty(item.ImagenPortada))
                            {
                                <span class="badge bg-info">Tiene foto</span>
                            }
                            else
                            {
                                <span class="text-muted">Sin foto</span>
                            }       
                        </td>
                        <td class="align-middle">
                            @if (item.Estado)
                            {
                                <span class="badge bg-success">Disponible</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Suspendido</span>
                            }
                        </td>
                        
                        <td class="align-middle">@item.Dueño.Nombre @item.Dueño.Apellido</td>
                        <td class="align-middle">@item.Tipo.Nombre</td>
                        
                        
                        <td class="align-middle text-center">
                            <!-- Los botones del CRUD -->
                            <a href="/Inmueble/Edit/@item.IdInmueble" class="btn btn-sm btn-outline-warning" title="Editar">
                                Editar
                            </a>
                            <a href="/Inmueble/Borrar/@item.IdInmueble" class="btn btn-sm btn-outline-danger" title="Eliminar">
                                Borrar
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
