@model IEnumerable<ProyectoInmobiliaria.models.Inmueble>

@{
    ViewData["Title"] = "Listado de Inmuebles";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Gestión de Inmuebles</h2>

        <div>
            <a href="/Inmueble/Create" class="btn btn-primary me-3">
                + Nuevo Inmueble
            </a>

            <a href="/Inmueble/PorEstado" class="btn btn-outline-primary me-3">
                Filtrar por estado
            </a>

            <a href="/Inmueble/PorPropietario" class="btn btn-outline-primary me-3">
                Filtrar por propietario
            </a>

            <a href="/Inmueble/MasReservados" class="btn btn-outline-primary me-3">
                Filtrar Más Reservados
            </a>

            <a href="/Inmueble/SinReservas" class="btn btn-outline-primary me-3">
                Filtrar Sin Reservas
            </a>

            <a href="/Inmueble/DisponiblesEntreFechas" class="btn btn-outline-primary me-3">
                Filtrar Disponibles
            </a>
        </div>

    </div>

    <!-- FILTROS -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3 align-items-end">

                    <!-- BUSQUEDA GENERAL -->
                    <div class="col-md-4">

                        <label class="form-label fw-semibold">
                            Buscar inmueble
                        </label>

                        <input type="text"
                               name="busqueda"
                               value="@ViewBag.Busqueda"
                               class="form-control"
                               placeholder="Dirección..." />

                    </div>


                    <!-- PROPIETARIO -->
                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Propietario
                        </label>

                        <select id="selectPropietario"
                                name="idPropietario"
                                class="form-control">

                            @if (ViewBag.PropietarioSeleccionado != null)
                            {
                                var propietario = ViewBag.PropietarioSeleccionado;

                                <option value="@propietario.IdPropietario" selected>
                                    @propietario.Nombre @propietario.Apellido
                                    (DNI: @propietario.Dni)
                                </option>
                            }

                        </select>

                    </div>


                    <!-- TIPO DE INMUEBLE -->
                    <div class="col-md-3">

                        <label class="form-label fw-semibold">
                            Tipo de inmueble
                        </label>

                        <select id="selectTipoInmueble"
                                name="idTipoInmueble"
                                class="form-control">

                            @if (ViewBag.TipoSeleccionado != null)
                            {
                                var tipo = ViewBag.TipoSeleccionado;

                                <option value="@tipo.IdTipoInmueble" selected>
                                    @tipo.Nombre
                                </option>
                            }

                        </select>

                    </div>


                    <!-- BOTON BUSCAR -->
                    <div class="col-md-2">

                        <button type="submit"
                                class="btn btn-primary w-100">

                            <i class="bi bi-search"></i>

                            Buscar

                        </button>

                    </div>

                </div>


                <!-- BOTON LIMPIAR -->

                <div class="mt-3">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">

                        Limpiar filtros

                    </a>

                </div>

            </form>

        </div>

    </div>


    <!-- TABLA -->

    <div class="table-responsive shadow-sm rounded">

        <table class="table table-striped table-hover mb-0">

            <thead class="table-dark">

                <tr>

                    <th>Dirección</th>

                    <th>Cupo</th>

                    <th>Coordenadas</th>

                    <th>Precio / Día</th>

                    <th>Imagen</th>

                    <th>Estado</th>

                    <th>Dueño</th>

                    <th>Tipo de Inmueble</th>

                    <th class="text-center">
                        Acciones
                    </th>

                </tr>

            </thead>


            <tbody>

                @if (Model != null && Model.Any())
                {

                    @foreach (var item in Model)
                    {

                        <tr>

                            <td class="align-middle">

                                <strong>
                                    @item.Direccion
                                </strong>

                            </td>


                            <td class="align-middle">
                                @item.Cupo
                            </td>


                            <td class="align-middle">
                                @item.Coordenadas
                            </td>


                            <td class="align-middle">
                                @item.PrecioPorDia
                            </td>


                            <!-- IMAGEN -->

                            <td class="align-middle">

                                @if (!string.IsNullOrEmpty(item.ImagenPortada))
                                {

                                    <img src="@item.ImagenPortada"
                                         alt="Imagen del inmueble"
                                         style="width:100px;
                                    height:70px;
                                    object-fit:cover;"
                                         class="rounded" />

                                }
                                else
                                {

                                    <span class="text-muted">
                                        Sin foto
                                    </span>

                                }

                            </td>


                            <!-- ESTADO -->

                            <td class="align-middle">

                                @if (item.Estado)
                                {

                                    <span class="badge bg-success">
                                        Disponible
                                    </span>

                                }
                                else
                                {

                                    <span class="badge bg-danger">
                                        Suspendido
                                    </span>

                                }

                            </td>


                            <!-- PROPIETARIO -->

                            <td class="align-middle">

                                @item.Dueño.Nombre
                                @item.Dueño.Apellido

                            </td>


                            <!-- TIPO -->

                            <td class="align-middle">

                                @item.Tipo.Nombre

                            </td>


                            <!-- ACCIONES -->

                            <td class="align-middle text-center">

                                <a href="/Inmueble/Edit/@item.IdInmueble"
                                   class="btn btn-sm btn-outline-warning"
                                   title="Editar">

                                    Editar

                                </a>


                                @if (User.IsInRole("Administrador"))
                                {

                                    <a href="/Inmueble/Delete/@item.IdInmueble"
                                       class="btn btn-sm btn-outline-danger"
                                       title="Eliminar">

                                        Borrar

                                    </a>

                                }


                                <a href="/Inmueble/Details/@item.IdInmueble"
                                   class="btn btn-sm btn-outline-info">

                                    Detalles

                                </a>

                            </td>

                        </tr>

                    }

                }
                else
                {

                    <tr>

                        <td colspan="9"
                            class="text-center text-muted py-4">

                            No se encontraron inmuebles.

                        </td>

                    </tr>

                }

            </tbody>

        </table>

    </div>

    <!-- PAGINACION -->
    @if (User.IsInRole("Administrador") && ViewBag.TotalPaginas > 1)
    {

        <nav class="mt-3">

            <ul class="pagination justify-content-center">


                <!-- ANTERIOR -->

                <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">

                    <a class="page-link"
                       href="@Url.Action("Index", new
                       {
                           busqueda = ViewBag.Busqueda,
                           idPropietario = ViewBag.IdPropietario,
                           idTipoInmueble = ViewBag.IdTipoInmueble,
                           pagina = ViewBag.PaginaActual - 1
                       })">

                        Anterior

                    </a>

                </li>


                <!-- NUMEROS -->
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {

                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                        <a class="page-link"
                           href="@Url.Action("Index", new
                           {
                               busqueda = ViewBag.Busqueda,
                               idPropietario = ViewBag.IdPropietario,
                               idTipoInmueble = ViewBag.IdTipoInmueble,
                               pagina = i
                           })">

                            @i

                        </a>

                    </li>

                }


                <!-- SIGUIENTE -->

                <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">

                    <a class="page-link"
                       href="@Url.Action("Index", new
                       {
                           busqueda = ViewBag.Busqueda,
                           idPropietario = ViewBag.IdPropietario,
                           idTipoInmueble = ViewBag.IdTipoInmueble,
                           pagina = ViewBag.PaginaActual + 1
                       })">

                        Siguiente

                    </a>

                </li>

            </ul>

        </nav>

    }

</div>



<!-- SELECT2 -->

@section Scripts {

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css"
          rel="stylesheet" />

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>


    <script>

        $(document).ready(function() {



            // SELECT PROPIETARIO

            $('#selectPropietario').select2({

                placeholder: 'Buscar propietario...',

                allowClear: true,

                minimumInputLength: 1,

                width: '100%',

                ajax: {

                    url: '@Url.Action("BuscarPropietarios", "Inmueble")',

                    dataType: 'json',

                    delay: 250,

                    data: function(params) {

                        return {
                            term: params.term
                        };

                    },

                    processResults: function(data) {

                        return {

                            results: data

                        };

                    },

                    cache: true

                }

            });


            // SELECT TIPO INMUEBLE

            $('#selectTipoInmueble').select2({

                placeholder: 'Buscar tipo...',

                allowClear: true,

                minimumInputLength: 1,

                width: '100%',

                ajax: {

                    url: '@Url.Action("BuscarTiposInmueble", "Inmueble")',

                    dataType: 'json',

                    delay: 250,

                    data: function(params) {

                        return {
                            term: params.term
                        };

                    },

                    processResults: function(data) {

                        return {

                            results: data

                        };

                    },

                    cache: true

                }

            });


        });

    </script>

}