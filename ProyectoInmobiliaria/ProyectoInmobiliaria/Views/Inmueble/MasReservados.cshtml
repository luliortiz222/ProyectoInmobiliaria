@model List<ProyectoInmobiliaria.models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles más reservados";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-trophy-fill text-warning"></i>
                Inmuebles más reservados
            </h2>

            <p class="text-muted mb-0">
                Inmuebles ordenados según la cantidad de reservas de los últimos 365 días.
            </p>
        </div>

        <a href="/Inmueble/Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Volver
        </a>

    </div>


    <!-- Resultados -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-bar-chart-fill"></i>
                Ranking de reservas
            </h5>

            <span class="badge bg-light text-primary rounded-pill">
                Últimos 365 días
            </span>

        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Count > 0)
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">
                            <tr>
                                <th>Posición</th>
                                <th>Dirección</th>
                                <th>Tipo</th>
                                <th>Dueño</th>
                                <th>Precio / Día</th>
                                <th class="text-center">Reservas</th>
                                <th class="text-center">Estado</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int posicion = 1;
                            }

                            @foreach (var inmueble in Model)
                            {
                                <tr>

                                    <td class="fw-bold">
                                        @if (posicion == 1)
                                        {
                                            <span class="badge bg-warning text-dark fs-6">
                                                🥇 @posicion°
                                            </span>
                                        }
                                        else if (posicion == 2)
                                        {
                                            <span class="badge bg-secondary fs-6">
                                                🥈 @posicion°
                                            </span>
                                        }
                                        else if (posicion == 3)
                                        {
                                            <span class="badge bg-danger fs-6">
                                                🥉 @posicion°
                                            </span>
                                        }
                                        else
                                        {
                                            <span>
                                                @posicion°
                                            </span>
                                        }
                                    </td>

                                    <td>
                                        <strong>
                                            <i class="bi bi-geo-alt-fill text-danger"></i>
                                            @inmueble.Direccion
                                        </strong>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @(inmueble.Tipo?.Nombre ?? "Sin tipo")
                                        </span>
                                    </td>

                                    <td>
                                        <i class="bi bi-person-fill text-secondary"></i>
                                        @(inmueble.Dueño?.Nombre ?? "")
                                        @(inmueble.Dueño?.Apellido ?? "")
                                    </td>

                                    <td>
                                        <span class="fw-semibold text-success">
                                            $ @inmueble.PrecioPorDia
                                        </span>
                                    </td>

                                    <td class="text-center">

                                        <span class="badge bg-primary rounded-pill fs-6 px-3 py-2">
                                            <i class="bi bi-calendar-check-fill"></i>
                                            @inmueble.CantidadReservas
                                        </span>

                                    </td>

                                    <td class="text-center">

                                        @if (inmueble.Estado)
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Disponible
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="bi bi-x-circle-fill"></i>
                                                No disponible
                                            </span>
                                        }

                                    </td>

                                </tr>

                                posicion++;
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="p-5 text-center">

                    <i class="bi bi-calendar-x display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No hay reservas registradas
                    </h5>

                    <p class="text-muted mb-0">
                        No se encontraron reservas en los últimos 365 días.
                    </p>

                </div>
            }

        </div>
    </div>

</div>
