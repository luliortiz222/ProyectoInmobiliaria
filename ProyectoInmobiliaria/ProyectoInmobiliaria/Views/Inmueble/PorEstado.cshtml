@model List<ProyectoInmobiliaria.models.Inmueble>

@{
    ViewData["Title"] = "Inmuebles por estado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-house-door-fill text-primary"></i>
                Inmuebles por estado
            </h2>

            <p class="text-muted mb-0">
                Consultá los inmuebles según su disponibilidad.
            </p>
        </div>

        <a href="/Inmueble/Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Volver
        </a>

    </div>


    <!-- Filtro -->
    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-funnel-fill"></i>
                Filtrar inmuebles
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="PorEstado" method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-6">

                        <label class="form-label fw-semibold">
                            Disponibilidad
                        </label>

                        <select name="estado" class="form-select">

                            <option value=""
                                    selected="@(ViewBag.Estado == null)">
                                Todos
                            </option>

                            <option value="true"
                                    selected="@(ViewBag.Estado != null && ViewBag.Estado == true)">
                                Disponible
                            </option>

                            <option value="false"
                                    selected="@(ViewBag.Estado != null && ViewBag.Estado == false)">
                                No disponible
                            </option>

                        </select>

                    </div>

                    <div class="col-md-3">

                        <button type="submit"
                                class="btn btn-primary w-100">
                            <i class="bi bi-search"></i>
                            Filtrar
                        </button>

                    </div>

                    <div class="col-md-3">

                    </div>

                </div>

            </form>

        </div>
    </div>


    <!-- Resultado -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-light d-flex justify-content-between align-items-center">

            <h5 class="mb-0 fw-semibold">
                Resultados
            </h5>

            <span class="badge bg-primary rounded-pill">
                @Model.Count inmueble(s)
            </span>

        </div>

        <div class="card-body p-0">

            @if (Model != null && Model.Count > 0)
            {

                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>
                                <th>Dirección</th>
                                <th>Cupo</th>
                                <th>Precio / Día</th>
                                <th>Tipo</th>
                                <th>Dueño</th>
                                <th class="text-center">Estado</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var inmueble in Model)
                            {
                                <tr>

                                    <td>
                                        <strong>
                                            <i class="bi bi-geo-alt-fill text-danger"></i>
                                            @inmueble.Direccion
                                        </strong>
                                    </td>

                                    <td>
                                        <i class="bi bi-people-fill text-secondary"></i>
                                        @inmueble.Cupo
                                    </td>

                                    <td>
                                        <span class="fw-semibold text-success">
                                            $ @inmueble.PrecioPorDia
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @(inmueble.Tipo?.Nombre ?? "Sin tipo")
                                        </span>
                                    </td>

                                    <td>
                                        <i class="bi bi-person-fill text-secondary"></i>
                                        @(inmueble.Dueño?.Nombre ?? "")
                                        @(inmueble.Dueño?.Apellido ?? "")
                                    </td>

                                    <td class="text-center">

                                        @if (inmueble.Estado)
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Disponible
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="bi bi-x-circle-fill"></i>
                                                No disponible
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            }
            else
            {

                <div class="p-5 text-center">

                    <i class="bi bi-house-x display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No se encontraron inmuebles
                    </h5>

                    <p class="text-muted mb-0">
                        No hay inmuebles que coincidan con el filtro seleccionado.
                    </p>

                </div>

            }

        </div>
    </div>

</div>