@model ProyectoInmobiliaria.models.Reserva

@{
    ViewData["Title"] = "Nueva Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>Registrar Nueva Reserva</h2>

    <hr />

    <div class="row">

        <div class="col-md-8 offset-md-2">

            <div class="card shadow-sm">

                <div class="card-body">

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <form action="/Reservas/Create" method="post">

                        <!-- INQUILINO -->

                        <div class="mb-3">

                            <label class="form-label">
                                Inquilino
                            </label>

                            <select name="IdInquilino"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Seleccione un Inquilino --
                                </option>

                                @foreach (var inquilino in ViewBag.Inquilinos)
                                {
                                    <option value="@inquilino.IdInquilino"
                                            selected="@(Model != null && Model.IdInquilino == inquilino.IdInquilino)">
                                        @inquilino.Nombre @inquilino.Apellido
                                        (DNI: @inquilino.Dni)
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- INMUEBLE -->

                        <div class="mb-3">

                            <label class="form-label">
                                Inmueble
                            </label>

                            <select name="IdInmueble"
                                    id="IdInmueble"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Seleccione un Inmueble --
                                </option>

                                @foreach (var inmueble in ViewBag.Inmuebles)
                                {
                                    <option value="@inmueble.IdInmueble"
                                            data-precio="@inmueble.PrecioPorDia"
                                            data-porcentaje="@inmueble.PorcentajeReserva"
                                            selected="@(Model != null && Model.IdInmueble == inmueble.IdInmueble)">
                                        @inmueble.Direccion
                                        - $@inmueble.PrecioPorDia por día
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- DATOS DE RESERVA DEL INMUEBLE -->

                        <div id="datosReserva"
                             class="alert alert-info"
                             style="display:none;">

                            <strong>Datos de la reserva</strong>

                            <div class="mt-2">
                                Porcentaje de reserva:
                                <strong id="porcentajeReserva">0%</strong>
                            </div>

                            <div>
                                Total del alquiler:
                                <strong id="totalAlquiler">$0,00</strong>
                            </div>

                            <div>
                                Pago inicial de reserva:
                                <strong id="pagoInicial">$0,00</strong>
                            </div>

                        </div>


                        <!-- MONTO -->

                        <div class="mb-3">

                            <label class="form-label">
                                Monto por Día
                            </label>

                            <input type="number"
                                   name="MontoPorDia"
                                   id="MontoPorDia"
                                   class="form-control"
                                   step="0.01"
                                   min="0"
                                   value="@(Model?.MontoPorDia ?? 0)"
                                   readonly
                                   required />

                            <div class="form-text">
                                El monto se obtiene automáticamente del inmueble seleccionado.
                            </div>

                        </div>


                        <!-- FECHAS -->

                        <div class="row">

                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Fecha Desde
                                </label>

                                <input type="date"
                                       name="FechaDesde"
                                       id="FechaDesde"
                                       class="form-control"
                                       value="@(Model?.FechaDesde != null && Model.FechaDesde != DateTime.MinValue
                                                                            ? Model.FechaDesde.ToString("yyyy-MM-dd")
                                                                            : DateTime.Today.ToString("yyyy-MM-dd"))"
                                       required />

                            </div>


                            <div class="col-md-6 mb-3">

                                <label class="form-label">
                                    Fecha Hasta
                                </label>

                                <input type="date"
                                       name="FechaHasta"
                                       id="FechaHasta"
                                       class="form-control"
                                       value="@(Model?.FechaHasta != null && Model.FechaHasta != DateTime.MinValue
                                                                            ? Model.FechaHasta.ToString("yyyy-MM-dd")
                                                                            : DateTime.Today.AddDays(1).ToString("yyyy-MM-dd"))"
                                       required />

                            </div>

                        </div>


                        <div class="d-flex justify-content-end gap-2">

                            <a href="/Reservas/Index"
                               class="btn btn-secondary">
                                Cancelar
                            </a>

                            <button type="submit"
                                    class="btn btn-success">
                                Guardar Reserva
                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<script>

    const selectInmueble = document.getElementById("IdInmueble");
    const montoPorDia = document.getElementById("MontoPorDia");
    const fechaDesde = document.getElementById("FechaDesde");
    const fechaHasta = document.getElementById("FechaHasta");

    const datosReserva = document.getElementById("datosReserva");
    const porcentajeReserva = document.getElementById("porcentajeReserva");
    const totalAlquiler = document.getElementById("totalAlquiler");
    const pagoInicial = document.getElementById("pagoInicial");


    function actualizarReserva() {

        const opcion = selectInmueble.options[selectInmueble.selectedIndex];

        if (!opcion || !opcion.value) {

            datosReserva.style.display = "none";

            montoPorDia.value = "";

            return;
        }


        const precio = parseFloat(opcion.dataset.precio) || 0;
        const porcentaje = parseFloat(opcion.dataset.porcentaje) || 0;


        // Mostrar precio automáticamente
        montoPorDia.value = precio.toFixed(2);


        // Mostrar datos
        datosReserva.style.display = "block";

        porcentajeReserva.textContent =
            porcentaje.toFixed(2) + "%";


        calcularPagoInicial();
    }


    function calcularPagoInicial() {

        const opcion = selectInmueble.options[selectInmueble.selectedIndex];

        if (!opcion || !opcion.value) {
            return;
        }


        const precio = parseFloat(montoPorDia.value) || 0;
        const porcentaje = parseFloat(opcion.dataset.porcentaje) || 0;


        if (!fechaDesde.value || !fechaHasta.value) {

            totalAlquiler.textContent = "$0,00";
            pagoInicial.textContent = "$0,00";

            return;
        }


        const desde = new Date(fechaDesde.value + "T00:00:00");
        const hasta = new Date(fechaHasta.value + "T00:00:00");


        const diferencia =
            (hasta - desde) / (1000 * 60 * 60 * 24);


        if (diferencia <= 0) {

            totalAlquiler.textContent = "$0,00";
            pagoInicial.textContent = "$0,00";

            return;
        }


        const total = diferencia * precio;

        const inicial = total * porcentaje / 100;


        totalAlquiler.textContent =
            "$" + total.toLocaleString("es-AR", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });


        pagoInicial.textContent =
            "$" + inicial.toLocaleString("es-AR", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });

    }


    selectInmueble.addEventListener("change", actualizarReserva);

    fechaDesde.addEventListener("change", calcularPagoInicial);

    fechaHasta.addEventListener("change", calcularPagoInicial);


    // Ejecutar al cargar
    actualizarReserva();

</script>