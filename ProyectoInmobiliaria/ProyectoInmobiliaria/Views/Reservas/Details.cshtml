@model ProyectoInmobiliaria.models.Reserva

@{
    ViewData["Title"] = "Detalles de Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <h2>Detalles de la Reserva</h2>
    <hr />

    <div class="card shadow-sm col-md-7">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-4">
                    ID Reserva
                </dt>
                <dd class="col-sm-8">
                    @Model.IdReserva
                </dd>

                <dt class="col-sm-4">
                    ID Inquilino
                </dt>
                <dd class="col-sm-8">
                    @Model.IdInquilino
                </dd>

                <dt class="col-sm-4">
                    ID Inmueble
                </dt>
                <dd class="col-sm-8">
                    @Model.IdInmueble
                </dd>

                <dt class="col-sm-4">
                    Monto por Día
                </dt>
                <dd class="col-sm-8">
                    $ @Model.MontoPorDia
                </dd>

                <dt class="col-sm-4">
                    Fecha Desde
                </dt>
                <dd class="col-sm-8">
                    @Model.FechaDesde.ToString("dd/MM/yyyy")
                </dd>

                <dt class="col-sm-4">
                    Fecha Hasta
                </dt>
                <dd class="col-sm-8">
                    @Model.FechaHasta.ToString("dd/MM/yyyy")
                </dd>

            </dl>

            @if (User.IsInRole("Administrador"))
            {
                <hr />

                <div class="card border-primary mb-4">

                    <div class="card-header bg-primary text-white">
                        <i class="bi bi-shield-lock-fill"></i>
                        Información de auditoría
                    </div>

                    <div class="card-body">

                        <dl class="row mb-0">

                            <dt class="col-sm-5">
                                Usuario creador
                            </dt>

                            <dd class="col-sm-7">
                                @if (Model.IdUsuarioCreador == 0)
                                {
                                    <span class="text-muted">
                                        No registrado
                                    </span>
                                }
                                else
                                {
                                    @Model.IdUsuarioCreador
                                }
                            </dd>

                            <dt class="col-sm-5">
                                Usuario finalizador
                            </dt>

                            <dd class="col-sm-7">
                                @if (Model.IdUsuarioFinalizador.HasValue)
                                {
                                    @Model.IdUsuarioFinalizador
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Reserva aún no finalizada
                                    </span>
                                }
                            </dd>

                            <dt class="col-sm-5">
                                Fecha de finalización
                            </dt>

                            <dd class="col-sm-7">
                                @if (Model.FechaFinalizacion.HasValue)
                                {
                                    @Model.FechaFinalizacion.Value.ToString("dd/MM/yyyy")
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Sin finalizar
                                    </span>
                                }
                            </dd>

                        </dl>

                    </div>

                </div>
            }

            <hr />

            <div>
                <a href="/Reservas/Edit/@Model.IdReserva"
                   class="btn btn-warning">
                    Editar
                </a>

                <a href="/Reservas/Delete/@Model.IdReserva"
                   class="btn btn-danger">
                    Eliminar
                </a>

                <a href="/Reservas/Index"
                   class="btn btn-secondary">
                    Volver
                </a>
            </div>

        </div>

    </div>
</div>