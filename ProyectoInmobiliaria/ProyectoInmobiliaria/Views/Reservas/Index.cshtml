@model IEnumerable<ProyectoInmobiliaria.models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Reservas</h2>

        <a href="/Reservas/Create" class="btn btn-primary">
            + Nueva Reserva
        </a>
    </div>

    <div class="table-responsive shadow-sm rounded">

        <table class="table table-striped table-hover mb-0">

            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Inquilino</th>
                    <th>Inmueble</th>
                    <th>Monto por Día</th>
                    <th>Fecha Desde</th>
                    <th>Fecha Hasta</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td class="align-middle">
                            @item.IdReserva
                        </td>

                        <td class="align-middle">
                            Inquilino #@item.IdInquilino
                        </td>

                        <td class="align-middle">
                            Inmueble #@item.IdInmueble
                        </td>

                        <td class="align-middle">
                            $ @item.MontoPorDia.ToString("N2")
                        </td>

                        <td class="align-middle">
                            @item.FechaDesde.ToString("dd/MM/yyyy")
                        </td>

                        <td class="align-middle">
                            @item.FechaHasta.ToString("dd/MM/yyyy")
                        </td>

                        <td class="align-middle text-center">

                            <a href="/Reservas/Details/@item.IdReserva"
                               class="btn btn-sm btn-outline-info">
                                Detalles
                            </a>

                            <a href="/Reservas/Edit/@item.IdReserva"
                               class="btn btn-sm btn-outline-warning">
                                Editar
                            </a>

                            <a href="/Reservas/Delete/@item.IdReserva"
                               class="btn btn-sm btn-outline-danger">
                                Borrar
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>