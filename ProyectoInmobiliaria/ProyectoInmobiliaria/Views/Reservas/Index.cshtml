@model IEnumerable<ProyectoInmobiliaria.models.Reserva>

@{
    ViewData["Title"] = "Listado de Reservas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.css" rel="stylesheet">

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2>Gestión de Reservas</h2>

        <div class="d-flex gap-2">

            <a href="/Reservas/Create"
               class="btn btn-primary">
                + Nueva Reserva
            </a>

            <a href="/Reservas/Vigentes"
               class="btn btn-outline-primary">
                Reservas vigentes
            </a>

            <a href="/Reservas/TerminanEn?dias=7"
               class="btn btn-outline-warning">
                Próximas a terminar
            </a>

        </div>

    </div>


    <!-- FILTROS -->

    <div class="card shadow-sm mb-4">

        <div class="card-body">

            <form action="/Reservas/Index"
                  method="get">

                <!-- BUSCADOR GENERAL -->

                <div class="mb-3">

                    <label class="form-label fw-bold">
                        Buscar reserva
                    </label>

                    <div class="row">

                        <div class="col-md-9">

                            <input type="text"
                                   name="busqueda"
                                   class="form-control"
                                   value="@ViewBag.Busqueda"
                                   placeholder="Buscar por N° reserva, N° inquilino, N° inmueble, nombre o dirección" />

                        </div>

                        <div class="col-md-3">

                            <button type="submit"
                                    class="btn btn-primary w-100">
                                Buscar
                            </button>

                        </div>

                    </div>

                </div>


                <!-- SELECTS DE BÚSQUEDA -->

                <div class="row">

                    <!-- INQUILINO -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Buscar por Inquilino
                        </label>

                        <select name="idInquilino"
                                id="selectInquilino"
                                class="form-select">

                            <option value="">
                                Todos los inquilinos
                            </option>

                            @foreach (var inquilino in ViewBag.Inquilinos)
                            {
                                if (ViewBag.IdInquilino != null &&
                                    ViewBag.IdInquilino == inquilino.IdInquilino)
                                {
                                    <option value="@inquilino.IdInquilino"
                                            selected>
                                        @inquilino.Nombre @inquilino.Apellido
                                        - DNI: @inquilino.Dni
                                    </option>
                                }
                                else
                                {
                                    <option value="@inquilino.IdInquilino">
                                        @inquilino.Nombre @inquilino.Apellido
                                        - DNI: @inquilino.Dni
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- INMUEBLE -->

                    <div class="col-md-6 mb-3">

                        <label class="form-label fw-bold">
                            Buscar por Inmueble
                        </label>

                        <select name="idInmueble"
                                id="selectInmueble"
                                class="form-select">

                            <option value="">
                                Todos los inmuebles
                            </option>

                            @foreach (var inmueble in ViewBag.Inmuebles)
                            {
                                if (ViewBag.IdInmueble != null &&
                                    ViewBag.IdInmueble == inmueble.IdInmueble)
                                {
                                    <option value="@inmueble.IdInmueble"
                                            selected>
                                        @inmueble.Direccion
                                    </option>
                                }
                                else
                                {
                                    <option value="@inmueble.IdInmueble">
                                        @inmueble.Direccion
                                    </option>
                                }
                            }

                        </select>

                    </div>

                </div>


                <!-- BOTONES -->

                <div class="d-flex justify-content-end gap-2">

                    <a href="/Reservas/Index"
                       class="btn btn-secondary">
                        Limpiar filtros
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        Filtrar
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- TABLA -->

    <div class="table-responsive shadow-sm rounded">

        <table class="table table-striped table-hover mb-0">

            <thead class="table-dark">

                <tr>

                    <th>ID</th>

                    <th>Inquilino</th>

                    <th>Dirección del Inmueble</th>

                    <th>Monto por Día</th>

                    <th>Fecha Desde</th>

                    <th>Fecha Hasta</th>

                    <th class="text-center">
                        Acciones
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var item in Model)
                {
                    <tr>

                        <td class="align-middle">
                            @item.IdReserva
                        </td>

                        <td class="align-middle">
                            @item.NombreInquilino
                        </td>

                        <td class="align-middle">
                            @item.DireccionInmueble
                        </td>

                        <td class="align-middle">
                            $ @item.MontoPorDia.ToString("N2")
                        </td>

                        <td class="align-middle">
                            @item.FechaDesde.ToString("dd/MM/yyyy")
                        </td>

                        <td class="align-middle">
                            @item.FechaHasta.ToString("dd/MM/yyyy")
                        </td>

                        <td class="align-middle text-center">

                            <a href="/Reservas/Details/@item.IdReserva"
                               class="btn btn-sm btn-outline-info">
                                Detalles
                            </a>

                            <a href="/Reservas/Edit/@item.IdReserva"
                               class="btn btn-sm btn-outline-warning">
                                Editar
                            </a>

                            @if (User.IsInRole("Administrador"))
                            {
                                <a href="/Reservas/Delete/@item.IdReserva"
                                   class="btn btn-sm btn-outline-danger">
                                    Borrar
                                </a>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- PAGINACIÓN -->
    @if (ViewBag.TotalPaginas > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                        <a class="page-link"
                           href="/Reservas/Index?pagina=@i&busqueda=@ViewBag.Busqueda&idInquilino=@ViewBag.IdInquilino&idInmueble=@ViewBag.IdInmueble">
                            @i
                        </a>

                    </li>
                }

            </ul>

        </nav>
    }

</div>


<!-- TOM SELECT -->

<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>

<script>

    new TomSelect("#selectInquilino", {
        create: false,
        allowEmptyOption: true,
        placeholder: "Buscar inquilino..."
    });

    new TomSelect("#selectInmueble", {
        create: false,
        allowEmptyOption: true,
        placeholder: "Buscar inmueble por dirección..."
    });

</script>