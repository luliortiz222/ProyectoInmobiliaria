@model IEnumerable<ProyectoInmobiliaria.models.TipoInmueble>

@{
    ViewData["Title"] = "Gestión de Tipos de Inmueble";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Listado de Tipos de Inmueble</h2>

    <a href="/TipoInmuebles/Create"
       class="btn btn-primary">
        + Nuevo Tipo
    </a>
</div>

<!-- Buscador -->
<div class="card shadow-sm mb-4">
    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row g-3 align-items-end">

                <div class="col-md-9">
                    <label class="form-label fw-semibold">
                        Buscar tipo de inmueble
                    </label>

                    <input type="text"
                           name="busqueda"
                           value="@ViewBag.Busqueda"
                           class="form-control"
                           placeholder="Buscar por nombre" />
                </div>

                <div class="col-md-3">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>

            </div>

        </form>

    </div>
</div>


<div class="card shadow-sm">
    <div class="card-body p-0">

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.IdTipoInmueble
                                </td>

                                <td class="fw-bold">
                                    @item.Nombre
                                </td>

                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">

                                        <a href="/TipoInmuebles/Details/@item.IdTipoInmueble"
                                           class="btn btn-info">
                                            Detalles
                                        </a>

                                        <a href="/TipoInmuebles/Edit/@item.IdTipoInmueble"
                                           class="btn btn-warning">
                                            Editar
                                        </a>

                                        @if (User.IsInRole("Administrador"))
                                        {
                                            <a href="/TipoInmuebles/Delete/@item.IdTipoInmueble"
                                               class="btn btn-danger">
                                                Eliminar
                                            </a>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3"
                                class="text-center text-muted py-4">
                                No hay tipos de inmueble registrados.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>


<!-- Paginación -->
@if (ViewBag.TotalPaginas > 1)
{
    <nav class="mt-3">

        <ul class="pagination justify-content-center">

            <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new
                   {
                       busqueda = ViewBag.Busqueda,
                       pagina = ViewBag.PaginaActual - 1
                   })">
                    Anterior
                </a>
            </li>

            @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                    <a class="page-link"
                       href="@Url.Action("Index", new
                       {
                           busqueda = ViewBag.Busqueda,
                           pagina = i
                       })">
                        @i
                    </a>

                </li>
            }

            <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   href="@Url.Action("Index", new
                   {
                       busqueda = ViewBag.Busqueda,
                       pagina = ViewBag.PaginaActual + 1
                   })">
                    Siguiente
                </a>
            </li>

        </ul>

    </nav>
}
