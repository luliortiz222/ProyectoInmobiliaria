@model IEnumerable<ProyectoInmobiliaria.models.TipoInmueble>

@{
    ViewData["Title"] = "Gestión de Tipos de Inmueble";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Listado de Tipos de Inmueble</h2>

    <a href="/TipoInmuebles/Create"
       class="btn btn-primary">
        + Nuevo Tipo
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-0">

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Nombre</th>
                        <th class="text-center">Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @item.IdTipoInmueble
                                </td>

                                <td class="fw-bold">
                                    @item.Nombre
                                </td>

                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">

                                        <a href="/TipoInmuebles/Details/@item.IdTipoInmueble"
                                           class="btn btn-info">
                                            Detalles
                                        </a>

                                        <a href="/TipoInmuebles/Edit/@item.IdTipoInmueble"
                                           class="btn btn-warning">
                                            Editar
                                        </a>

                                        <a href="/TipoInmuebles/Delete/@item.IdTipoInmueble"
                                           class="btn btn-danger">
                                            Eliminar
                                        </a>

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3"
                                class="text-center text-muted py-4">
                                No hay tipos de inmueble registrados.
                            </td>
                        </tr>
                    }

                </tbody>
            </table>
        </div>
    </div>
</div>
