@model ProyectoInmobiliaria.models.TipoInmueble
@{
    ViewData["Title"] = "Eliminar Tipo de Inmueble";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<h2>Eliminar Tipo de Inmueble</h2>
<p class="text-danger fw-bold">
    ¿Estás seguro de que querés eliminar este tipo de inmueble?
</p>
<hr />
<div class="card col-md-6 shadow-sm mb-3">

    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">
                ID
            </dt>
            <dd class="col-sm-8">
                @Model.IdTipoInmueble
            </dd>
            <dt class="col-sm-4">
                Nombre
            </dt>
            <dd class="col-sm-8">
                @Model.Nombre
            </dd>

        </dl>

    </div>
</div>

<form action="/TipoInmuebles/Delete" method="post">
    <input type="hidden" name="id" value="@Model.IdTipoInmueble" />

    <button type="submit" class="btn btn-danger">
        Confirmar Eliminación
    </button>

    <!-- Cambiado asp-action por href directo -->
    <a href="/TipoInmuebles" class="btn btn-secondary">
        Cancelar
    </a>
</form>