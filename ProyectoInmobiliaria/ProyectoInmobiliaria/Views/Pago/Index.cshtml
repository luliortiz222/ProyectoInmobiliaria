@model IEnumerable<ProyectoInmobiliaria.models.Pago>

@{
    ViewData["Title"] = "Historial Global de Pagos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- ENCABEZADO -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-1">
                <i class="bi bi-wallet2 text-success"></i>
                Historial de Pagos
            </h2>

            <p class="text-muted mb-0">
                Consulta y administra los pagos registrados.
            </p>
        </div>
    </div>

    <hr />

    <!-- FILTROS -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white border-bottom">
            <h5 class="mb-0">
                <i class="bi bi-funnel"></i>
                Buscar y filtrar
            </h5>
        </div>

        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3 align-items-end">

                    <!-- BUSQUEDA -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Buscar pago
                        </label>

                        <input type="text"
                               name="busqueda"
                               value="@ViewBag.Busqueda"
                               class="form-control"
                               placeholder="Concepto, Nº de pago o importe..." />
                    </div>

                    <!-- RESERVA -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">
                            Reserva
                        </label>

                        <select name="idReserva"
                                id="selectReserva"
                                class="form-select">

                            <option value="">
                            </option>

                            @if (ViewBag.ReservaSeleccionada != null)
                            {
                                var reservaSeleccionada =
                                    (ProyectoInmobiliaria.models.Reserva)
                                    ViewBag.ReservaSeleccionada;

                                <option value="@reservaSeleccionada.IdReserva"
                                        selected>
                                    Reserva #@reservaSeleccionada.IdReserva
                                    -
                                    @reservaSeleccionada.NombreInquilino
                                    -
                                    @reservaSeleccionada.DireccionInmueble
                                </option>
                            }

                        </select>
                    </div>

                    <!-- ESTADO -->
                    <div class="col-md-2">
                        <label class="form-label fw-semibold">
                            Estado
                        </label>

                        <select name="estado" class="form-select">

                            <option value=""
                                    selected="@(ViewBag.Estado == null)">
                                Todos
                            </option>

                            <option value="true"
                                    selected="@(ViewBag.Estado is bool estado && estado)">
                                Activos
                            </option>

                            <option value="false"
                                    selected="@(ViewBag.Estado is bool estado2 && !estado2)">
                                Anulados
                            </option>

                        </select>
                    </div>

                    <!-- BOTON -->
                    <div class="col-md-2">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            <i class="bi bi-search"></i>
                            Buscar
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>


    <!-- TABLA -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i>
                Pagos registrados
            </h5>

            @if (Model != null)
            {
                <span class="badge bg-secondary">
                    Página @ViewBag.PaginaActual de @ViewBag.TotalPaginas
                </span>
            }

        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th class="ps-4">
                                Nº Pago
                            </th>

                            <th>
                                Nº Reserva
                            </th>

                            <th>
                                Fecha
                            </th>

                            <th>
                                Concepto
                            </th>

                            <th>
                                Importe
                            </th>

                            <th>
                                Estado
                            </th>

                            <th class="text-center pe-4">
                                Acciones
                            </th>
                        </tr>

                    </thead>

                    <tbody>

                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="7"
                                    class="text-center text-muted py-5">

                                    <i class="bi bi-wallet2 fs-1 d-block mb-2"></i>

                                    <div class="fw-semibold">
                                        No se encontraron pagos
                                    </div>

                                    <small>
                                        No hay pagos que coincidan con los filtros seleccionados.
                                    </small>

                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr class="@(!item.estado ? "table-secondary text-muted" : "")">

                                    <!-- ID PAGO -->
                                    <td class="ps-4 fw-bold">
                                        #@item.idPago
                                    </td>

                                    <!-- RESERVA -->
                                    <td>

                                        <a href="/Reservas/Details/@item.idReserva"
                                           class="text-decoration-none fw-semibold">

                                            <i class="bi bi-calendar-check"></i>
                                            Reserva #@item.idReserva

                                        </a>

                                    </td>

                                    <!-- FECHA -->
                                    <td>
                                        <span>
                                            @item.fechaPago.ToString("dd/MM/yyyy")
                                        </span>
                                    </td>

                                    <!-- CONCEPTO -->
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(item.concepto))
                                        {
                                            @item.concepto
                                        }
                                        else
                                        {
                                            <span class="text-muted fst-italic">
                                                Sin concepto
                                            </span>
                                        }
                                    </td>

                                    <!-- IMPORTE -->
                                    <td>

                                        <span class="fw-bold fs-6 @(item.estado ? "text-success" : "text-muted")">
                                            $@item.importe.ToString("N2")
                                        </span>

                                    </td>

                                    <!-- ESTADO -->
                                    <td>

                                        @if (item.estado)
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-check-circle"></i>
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="bi bi-x-circle"></i>
                                                Anulado
                                            </span>
                                        }

                                    </td>

                                    <!-- ACCIONES -->
                                    <td class="text-center pe-4">

                                        <div class="d-flex justify-content-center gap-2 flex-wrap">

                                            @if (User.IsInRole("Administrador"))
                                            {
                                                <a href="/Pago/Details/@item.idPago"
                                                   class="btn btn-outline-primary btn-sm px-3"
                                                   title="Ver detalles">

                                                    <i class="bi bi-eye"></i>
                                                    Detalles

                                                </a>
                                            }

                                            @if (item.estado)
                                            {
                                                <a href="/Pago/Edit/@item.idPago"
                                                   class="btn btn-outline-warning btn-sm px-3"
                                                   title="Editar concepto">

                                                    <i class="bi bi-pencil-square"></i>
                                                    Editar

                                                </a>

                                                @if (User.IsInRole("Administrador"))
                                                {
                                                    <a href="/Pago/Anular/@item.idPago"
                                                       class="btn btn-outline-danger btn-sm px-3"
                                                       title="Anular pago">

                                                        <i class="bi bi-x-circle"></i>
                                                        Anular

                                                    </a>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted small d-flex align-items-center">
                                                    <i class="bi bi-lock-fill me-1"></i>
                                                    Bloqueado
                                                </span>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>


    <!-- PAGINACIÓN -->
    @if (ViewBag.TotalPaginas > 1)
    {
        <nav class="mt-4">

            <ul class="pagination justify-content-center">

                <!-- ANTERIOR -->
                <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">

                    <a class="page-link"
                       href="@Url.Action("Index", new
                       {
                           busqueda = ViewBag.Busqueda,
                           estado = ViewBag.Estado,
                           idReserva = ViewBag.IdReserva,
                           pagina = ViewBag.PaginaActual - 1
                       })">

                        <i class="bi bi-chevron-left"></i>
                        Anterior

                    </a>

                </li>


                <!-- PAGINAS -->
                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                        <a class="page-link"
                           href="@Url.Action("Index", new
                           {
                               busqueda = ViewBag.Busqueda,
                               estado = ViewBag.Estado,
                               idReserva = ViewBag.IdReserva,
                               pagina = i
                           })">

                            @i

                        </a>

                    </li>
                }


                <!-- SIGUIENTE -->
                <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">

                    <a class="page-link"
                       href="@Url.Action("Index", new
                       {
                           busqueda = ViewBag.Busqueda,
                           estado = ViewBag.Estado,
                           idReserva = ViewBag.IdReserva,
                           pagina = ViewBag.PaginaActual + 1
                       })">

                        Siguiente
                        <i class="bi bi-chevron-right"></i>

                    </a>

                </li>

            </ul>

        </nav>
    }

</div>


<!-- TOM SELECT -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/css/tom-select.bootstrap5.min.css"
      rel="stylesheet" />

<script src="https://cdn.jsdelivr.net/npm/tom-select@2.4.3/dist/js/tom-select.complete.min.js"></script>


<script>

    new TomSelect("#selectReserva", {

        valueField: "id",
        labelField: "text",
        searchField: "text",

        create: false,
        allowEmptyOption: true,

        placeholder: "Buscar reserva...",

        load: function(query, callback) {

            if (query.length < 1) {
                callback();
                return;
            }

            fetch("/Pago/BuscarReservas?term=" + encodeURIComponent(query))

                .then(response => response.json())

                .then(data => {
                    callback(data);
                })

                .catch(() => {
                    callback();
                });
        }

    });

</script>