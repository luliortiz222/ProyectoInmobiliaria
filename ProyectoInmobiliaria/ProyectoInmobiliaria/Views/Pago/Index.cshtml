@model IEnumerable<ProyectoInmobiliaria.models.Pago>
@{
    ViewData["Title"] = "Historial Global de Pagos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-wallet2 text-success"></i> Todos los Pagos Registrados</h2>
    </div>
    <hr />

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nº Pago</th>
                    <th>Nº Reserva</th>
                    <th>Fecha</th>
                    <th>Concepto</th>
                    <th>Importe</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">No hay ningún pago registrado en el sistema todavía.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr class="@(!item.estado ? "table-secondary text-muted" : "")">
                            <td class="align-middle fw-bold">#@item.idPago</td>
                            <td class="align-middle">
                                <a href="/Reservas/Details/@item.idReserva" class="text-decoration-none">
                                    Reserva #@item.idReserva
                                </a>
                            </td>
                            <td class="align-middle">@item.fechaPago.ToString("dd/MM/yyyy")</td>
                            <td class="align-middle">@item.concepto</td>
                            <td class="align-middle fw-bold @(item.estado ? "text-success" : "")">
                                $@item.importe
                            </td>
                            <td class="align-middle">
                                @if (item.estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Anulado</span>
                                }
                            </td>
                            <td class="align-middle text-center">
                                @if (item.estado)
                                {
                                    <a href="/Pagos/Edit/@item.idPago" class="btn btn-sm btn-outline-warning" title="Editar Concepto">
                                        Editar
                                    </a>
                                    <a href="/Pagos/Anular/@item.idPago" class="btn btn-sm btn-outline-danger" title="Anular Pago">
                                        Anular
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-lock-fill"></i> Bloqueado</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>