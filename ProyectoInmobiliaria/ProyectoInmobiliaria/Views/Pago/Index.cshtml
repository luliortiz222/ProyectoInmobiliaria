@model IEnumerable<ProyectoInmobiliaria.models.Pago>

@{
    ViewData["Title"] = "Historial Global de Pagos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>
            <i class="bi bi-wallet2 text-success"></i>
            Todos los Pagos Registrados
        </h2>
    </div>

    <hr />

    <!-- Buscador y filtro -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-md-7">
                        <label class="form-label fw-semibold">
                            Buscar por concepto
                        </label>

                        <input type="text"
                               name="busqueda"
                               value="@ViewBag.Busqueda"
                               class="form-control"
                               placeholder="Buscar por concepto" />
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold">
                            Estado
                        </label>

                        <select name="estado" class="form-select">

                            <option value=""
                                    selected="@(ViewBag.Estado == null)">
                                Todos
                            </option>

                            <option value="true"
                                    selected="@(ViewBag.Estado is bool estado && estado)">
                                Activos
                            </option>

                            <option value="false"
                                    selected="@(ViewBag.Estado is bool estado2 && !estado2)">
                                Anulados
                            </option>

                        </select>
                    </div>

                    <div class="col-md-2">
                        <button type="submit"
                                class="btn btn-primary w-100">
                            <i class="bi bi-search"></i>
                            Buscar
                        </button>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover mb-0">

            <thead class="table-dark">
                <tr>
                    <th>Nº Pago</th>
                    <th>Nº Reserva</th>
                    <th>Fecha</th>
                    <th>Concepto</th>
                    <th>Importe</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>

                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7"
                            class="text-center text-muted py-4">
                            No hay pagos que coincidan con la búsqueda.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr class="@(!item.estado ? "table-secondary text-muted" : "")">

                            <td class="align-middle fw-bold">
                                #@item.idPago
                            </td>

                            <td class="align-middle">
                                <a href="/Reservas/Details/@item.idReserva"
                                   class="text-decoration-none">
                                    Reserva #@item.idReserva
                                </a>
                            </td>

                            <td class="align-middle">
                                @item.fechaPago.ToString("dd/MM/yyyy")
                            </td>

                            <td class="align-middle">
                                @item.concepto
                            </td>

                            <td class="align-middle fw-bold @(item.estado ? "text-success" : "")">
                                $@item.importe
                            </td>

                            <td class="align-middle">
                                @if (item.estado)
                                {
                                    <span class="badge bg-success">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Anulado
                                    </span>
                                }
                            </td>

                            <td class="align-middle text-center">

                                @if (User.IsInRole("Administrador"))
                                {
                                    <a href="/Pago/Details/@item.idPago"
                                       class="btn btn-sm btn-outline-primary"
                                       title="Ver detalles">
                                        Detalles
                                    </a>
                                }

                                @if (item.estado)
                                {
                                    <a href="/Pago/Edit/@item.idPago"
                                       class="btn btn-sm btn-outline-warning"
                                       title="Editar Concepto">
                                        Editar
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a href="/Pago/Anular/@item.idPago"
                                           class="btn btn-sm btn-outline-danger"
                                           title="Anular Pago">
                                            Anular
                                        </a>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        <i class="bi bi-lock-fill"></i>
                                        Bloqueado
                                    </span>
                                }

                            </td>
                        </tr>
                    }
                }

            </tbody>
        </table>
    </div>

    <!-- Paginación -->
    @if (ViewBag.TotalPaginas > 1)
    {
        <nav class="mt-3">

            <ul class="pagination justify-content-center">

                <li class="page-item @(ViewBag.PaginaActual <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", new
                       {
                           busqueda = ViewBag.Busqueda,
                           estado = ViewBag.Estado,
                           pagina = ViewBag.PaginaActual - 1
                       })">
                        Anterior
                    </a>
                </li>

                @for (int i = 1; i <= ViewBag.TotalPaginas; i++)
                {
                    <li class="page-item @(i == ViewBag.PaginaActual ? "active" : "")">

                        <a class="page-link"
                           href="@Url.Action("Index", new
                           {
                               busqueda = ViewBag.Busqueda,
                               estado = ViewBag.Estado,
                               pagina = i
                           })">
                            @i
                        </a>

                    </li>
                }

                <li class="page-item @(ViewBag.PaginaActual >= ViewBag.TotalPaginas ? "disabled" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", new
                       {
                           busqueda = ViewBag.Busqueda,
                           estado = ViewBag.Estado,
                           pagina = ViewBag.PaginaActual + 1
                       })">
                        Siguiente
                    </a>
                </li>

            </ul>

        </nav>
    }

</div>