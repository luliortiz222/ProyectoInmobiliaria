@model ProyectoInmobiliaria.models.Pago
@{
    ViewData["Title"] = "Editar Pago";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2>Editar Concepto del Pago #@Model.idPago</h2>
    <div class="alert alert-info">Por reglas del sistema, solo se permite modificar el concepto del pago.</div>
    <hr />

    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card shadow-sm border-warning">
                <div class="card-body">
                    <form action="/Pago/Edit" method="post">
                        <input type="hidden" name="IdPago" value="@Model.idPago" />
                        <input type="hidden" name="IdReserva" value="@Model.idReserva" />

                        <div class="mb-3">
                            <label class="form-label">Fecha del Pago</label>
                            <input type="text" class="form-control bg-light" value="@Model.fechaPago.ToString("dd/MM/yyyy")" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold text-primary">Concepto (Editable)</label>
                            <input type="text" name="Concepto" class="form-control border-primary" value="@Model.concepto" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Importe Registrado ($)</label>
                            <input type="text" class="form-control bg-light" value="@Model.importe" readonly />
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a href="/Pagos/PorReserva/@Model.idReserva" class="btn btn-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-warning">Guardar Cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>