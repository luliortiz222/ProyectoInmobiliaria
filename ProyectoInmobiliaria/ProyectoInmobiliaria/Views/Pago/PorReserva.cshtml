@model IEnumerable<ProyectoInmobiliaria.models.Pago>
@{
    ViewData["Title"] = "Pagos de la Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-cash-coin text-success"></i> Pagos de la Reserva #@ViewBag.IdReserva</h2>
        
        <div>
            <!-- El botón para ir a cobrar -->
            <a href="/Pago/Create/@ViewBag.IdReserva" class="btn btn-success">
                + Registrar Nuevo Pago
            </a>
            <a href="/Reservas" class="btn btn-secondary">Volver a Reservas</a>
        </div>
    </div>
    <hr />

    <div class="table-responsive shadow-sm rounded">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nº Pago</th>
                    <th>Fecha</th>
                    <th>Concepto</th>
                    <th>Importe</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No hay pagos registrados para esta reserva.</td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        <tr class="@(!item.estado ? "table-secondary text-muted" : "")">
                            <td class="align-middle">#@item.idPago</td>
                            <td class="align-middle">@item.fechaPago.ToString("dd/MM/yyyy")</td>
                            <td class="align-middle">@item.concepto</td>
                            <td class="align-middle fw-bold @(item.estado ? "text-success" : "")">
                                $@item.importe
                            </td>
                            <td class="align-middle">
                                @if (item.estado)
                                {
                                    <span class="badge bg-success">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Anulado</span>
                                }
                            </td>
                            <td class="align-middle text-center">
                                @if (item.estado)
                                {
                                    <a href="/Pago/Edit/@item.idPago" class="btn btn-sm btn-outline-warning" title="Editar Concepto">
                                        Editar
                                    </a>
                                    <a href="/Pago/Anular/@item.idPago" class="btn btn-sm btn-outline-danger" title="Anular Pago">
                                        Anular
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small"><i class="bi bi-lock-fill"></i> Bloqueado</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>