@model IEnumerable<ProyectoInmobiliaria.models.Pago>

@{
    ViewData["Title"] = "Pagos de la Reserva";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                <i class="bi bi-cash-coin text-success"></i>
                Pagos de la Reserva #@ViewBag.IdReserva
            </h2>

            <p class="text-muted mb-0">
                Consultá y registrá los pagos correspondientes a esta reserva.
            </p>
        </div>

        <div>
            <a href="/Pago/Create/@ViewBag.IdReserva"
               class="btn btn-success me-2">
                <i class="bi bi-plus-circle"></i>
                Registrar Nuevo Pago
            </a>

            <a href="/Reservas/Index"
               class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left"></i>
                Volver
            </a>
        </div>

    </div>


    <!-- Resultados -->
    <div class="card shadow-sm border-0">

        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

            <h5 class="mb-0">
                <i class="bi bi-list-check"></i>
                Pagos registrados
            </h5>

            <span class="badge bg-light text-primary rounded-pill">
                @Model.Count() pago(s)
            </span>

        </div>

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="p-5 text-center">

                    <i class="bi bi-cash-stack display-4 text-muted"></i>

                    <h5 class="mt-3">
                        No hay pagos registrados
                    </h5>

                    <p class="text-muted mb-3">
                        Esta reserva todavía no tiene pagos cargados.
                    </p>

                    <a href="/Pago/Create/@ViewBag.IdReserva"
                       class="btn btn-success">
                        <i class="bi bi-plus-circle"></i>
                        Registrar primer pago
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-dark">

                            <tr>
                                <th>Nº Pago</th>
                                <th>Fecha</th>
                                <th>Concepto</th>
                                <th>Importe</th>
                                <th class="text-center">Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr class="@(!item.estado ? "table-secondary text-muted" : "")">

                                    <td>
                                        <strong>
                                            #@item.idPago
                                        </strong>
                                    </td>

                                    <td>
                                        @item.fechaPago.ToString("dd/MM/yyyy")
                                    </td>

                                    <td>
                                        @item.concepto
                                    </td>

                                    <td>
                                        <span class="fw-bold @(item.estado ? "text-success" : "")">
                                            $ @item.importe.ToString("N2")
                                        </span>
                                    </td>

                                    <td class="text-center">

                                        @if (item.estado)
                                        {
                                            <span class="badge bg-success px-3 py-2">
                                                <i class="bi bi-check-circle-fill"></i>
                                                Activo
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger px-3 py-2">
                                                <i class="bi bi-x-circle-fill"></i>
                                                Anulado
                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        @if (item.estado)
                                        {
                                            <a href="/Pago/Edit/@item.idPago"
                                               class="btn btn-sm btn-outline-warning"
                                               title="Editar concepto">
                                                <i class="bi bi-pencil-fill"></i>
                                                Editar
                                            </a>

                                            <a href="/Pago/Anular/@item.idPago"
                                               class="btn btn-sm btn-outline-danger"
                                               title="Anular pago">
                                                <i class="bi bi-x-circle-fill"></i>
                                                Anular
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                <i class="bi bi-lock-fill"></i>
                                                Bloqueado
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>
    </div>

</div>