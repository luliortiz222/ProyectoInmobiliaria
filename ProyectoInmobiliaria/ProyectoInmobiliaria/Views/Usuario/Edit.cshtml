@model ProyectoInmobiliaria.models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Editar Usuario</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <form action="/Usuario/Edit" method="post" enctype="multipart/form-data">

            <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text"
                           name="Nombre"
                           class="form-control"
                           value="@Model.Nombre" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Apellido</label>
                    <input type="text"
                           name="Apellido"
                           class="form-control"
                           value="@Model.Apellido" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input type="email"
                           name="Email"
                           class="form-control"
                           value="@Model.Email" />
                </div>

                

                <div class="col-md-6 mb-3">
                    
                    @if (Model.Rol == "Administrador")
                    {
                        <label class="form-label">Rol</label>
                        <select name="Rol" class="form-select">

                            <option value="Administrador" selected>Administrador</option>
                            <option value="Empleado">Empleado</option>


                        </select>
                    }
                </div>

                <div class="mb-4 mt-3">

                    <label class="form-label fw-bold">
                        Seleccione un avatar
                    </label>

                    <input type="file" name="ArchivoImagen" class="form-control" accept="image/*" />

                </div>

            </div>

            <div class="mt-3">

                <button type="submit" class="btn btn-warning">
                    Guardar Cambios
                </button>

                <a href="/Usuario/Index" class="btn btn-secondary">
                    Volver
                </a>

            </div>

        </form>

    </div>
</div>
