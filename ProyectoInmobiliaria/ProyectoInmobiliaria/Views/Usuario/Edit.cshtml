@model ProyectoInmobiliaria.models.Usuario

@{
    ViewData["Title"] = "Editar Usuario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="mb-4">Editar Usuario</h2>

<div class="card shadow-sm">
    <div class="card-body">

        <form action="/Usuario/Edit" method="post">

            <input type="hidden" name="IdUsuario" value="@Model.IdUsuario" />

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text"
                           name="Nombre"
                           class="form-control"
                           value="@Model.Nombre" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Apellido</label>
                    <input type="text"
                           name="Apellido"
                           class="form-control"
                           value="@Model.Apellido" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Email</label>
                    <input type="email"
                           name="Email"
                           class="form-control"
                           value="@Model.Email" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Contraseña</label>
                    <input type="text"
                           name="Password"
                           class="form-control"
                           value="@Model.Password" />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Rol</label>

                    <select name="Rol" class="form-select">
                        @if (Model.Rol == "Administrador")
                        {
                            <option value="Administrador" selected>Administrador</option>
                            <option value="Empleado">Empleado</option>
                        }
                        else
                        {
                            <option value="Administrador">Administrador</option>
                            <option value="Empleado" selected>Empleado</option>
                        }
                    </select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">Avatar</label>
                    <input type="text"
                           name="Avatar"
                           class="form-control"
                           value="@Model.Avatar" />
                </div>

            </div>

            <div class="mt-3">

                <button type="submit" class="btn btn-warning">
                    Guardar Cambios
                </button>

                <a href="/Usuario/Index" class="btn btn-secondary">
                    Volver
                </a>

            </div>

        </form>

    </div>
</div>