<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Proyecto Inmobiliaria</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body>

    @if (ViewBag.OcultarNav != true)
        {
            <header>
                <nav class="navbar navbar-expand-sm navbar-dark bg-dark mb-4">
                    <div class="container">
                        <a class="navbar-brand fw-bold" asp-controller="Inquilinos" asp-action="Index">Inmobiliaria</a>
                        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li class="nav-item">
                                    <a class="nav-link text-light" href="/Inquilinos/Index" asp-controller="Inquilinos" asp-action="Index">Inquilinos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light" href="/Propietarios/Index" asp-controller="Propietarios" asp-action="Index">Propietarios</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light" href="/Inmueble/Index" asp-controller="Inmueble" asp-action="Index">Inmuebles</a>
                                </li>
                                <li class="nav-item"> 
                                    <a class="nav-link text-light" href="/Reservas/Index" asp-controller="Reservas" asp-action="Index">Reservas</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light" href="/TipoInmuebles/Index" asp-controller="TipoInmuebles" asp-action="Index"> Tipos de Inmueble</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light" href="/Pago/Index" asp-controller="Pagos" asp-action="Index">Pagos</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-light" href="/Usuario/Index" asp-controller="Usuario" asp-action="Index">Usuarios</a>
                                </li>


                                <ul class="navbar-nav ms-auto">
                                    <!-- LA MAGIA DE RAZOR: Preguntamos si el usuario inició sesión -->
                                    @if (User.Identity.IsAuthenticated)
                                    {
                                        <li class="nav-item">

                                            <span class="nav-link text-info fw-bold">
                                                <i class="bi bi-person-circle"></i> @User.Identity.Name
                                            </span>
                                        </li>
                                        <li class="nav-item">
                                            <a class="nav-link text-danger" href="/Usuario/Logout">
                                                <i class="bi bi-box-arrow-right"></i> Salir
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link btn btn-outline-primary text-primary px-3" href="/Usuario/Login">
                                                Iniciar Sesión
                                            </a>
                                        </li>
                                    }
                                </ul>




                            </ul>

                        </div>
                    </div>
                </nav>
            </header>
        }
        <div class="container">
        <main role="main" class="pb-3">
            <div class="container mt-3">
                @if (TempData["MensajeBienvenida"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill"></i> @TempData["MensajeBienvenida"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-3 mt-4">
        <div class="container text-center">
            &copy; 2026 - Proyecto Inmobiliaria - Ortiz Paez Lourdes & Fabricio Silva
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>