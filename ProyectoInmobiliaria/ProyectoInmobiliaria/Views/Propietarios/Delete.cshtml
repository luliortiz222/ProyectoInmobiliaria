@model ProyectoInmobiliaria.models.Propietario
@{
    ViewData["Title"] = "Eliminar Propietario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="card shadow-sm border-danger" style="max-width: 600px; margin: 0 auto;">
    <div class="card-header bg-danger text-white">
        <h4 class="mb-0">¿Estás seguro de que deseas eliminar este registro?</h4>
    </div>
    <div class="card-body text-center">
        <h5 class="card-title text-danger mb-4">Esta acción no se puede deshacer.</h5>

        
        <div class="alert alert-secondary text-start" role="alert">
            <strong>ID:</strong> @Model.IdPropietario<br>
            <strong>DNI:</strong> @Model.Dni<br>
            <strong>Nombre Completo:</strong> @Model.Nombre @Model.Apellido
        </div>

        
        <form action="/Propietarios/BorrarConfirmado" method="post">
            
            <input type="hidden" name="IdPropietario" value="@Model.IdPropietario" />

            <div class="d-flex justify-content-center gap-3 mt-4">
                <a href="/Propietarios" class="btn btn-secondary">Cancelar y Volver</a>
                <button type="submit" class="btn btn-danger">Sí, Eliminar Definitivamente</button>
            </div>
        </form>
    </div>
</div>
