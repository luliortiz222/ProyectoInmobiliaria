@model List<ProyectoInmobiliaria.models.Propietario>
@{
    ViewData["Title"] = "Propietarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Gestión de Propietarios</h2>
    <a href="/Propietarios/Create" class="btn btn-success">+ Nuevo Propietario</a>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>DNI</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Teléfono</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>@p.IdPropietario</td>
                        <td>@p.Dni</td>
                        <td>@p.Nombre</td>
                        <td>@p.Apellido</td>
                        <td>@p.Telefono</td>
                        <td>
                            
                            <a href="/Propietarios/Edit/@p.IdPropietario" class="btn btn-sm btn-warning">Editar</a>
                            <a href="/Propietarios/Borrar/@p.IdPropietario" class="btn btn-sm btn-danger">Eliminar</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>