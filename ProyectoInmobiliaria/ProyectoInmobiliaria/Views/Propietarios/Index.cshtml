@model List<ProyectoInmobiliaria.models.Propietario>

@{
    ViewData["Title"] = "Propietarios";
    Layout = "~/Views/Shared/_Layout.cshtml";

    int paginaActual = ViewBag.PaginaActual;
    int totalPaginas = ViewBag.TotalPaginas;
    string busqueda = ViewBag.Busqueda;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Gestión de Propietarios</h2>

    <a href="/Propietarios/Create" class="btn btn-success">
        + Nuevo Propietario
    </a>
</div>


<!-- Buscador -->
<div class="card shadow-sm mb-4">
    <div class="card-body">

        <form asp-action="Index" method="get">

            <div class="row g-3 align-items-end">

                <div class="col-md-9">
                    <label class="form-label fw-semibold">
                        Buscar propietario
                    </label>

                    <input type="text"
                           name="busqueda"
                           value="@busqueda"
                           class="form-control"
                           placeholder="Buscar por nombre, apellido o DNI" />
                </div>

                <div class="col-md-3">
                    <button type="submit"
                            class="btn btn-primary w-100">
                        <i class="bi bi-search"></i>
                        Buscar
                    </button>
                </div>

            </div>

        </form>

    </div>
</div>


<!-- Listado -->
<div class="card shadow-sm">
    <div class="card-body">

        <div class="table-responsive">

            <table class="table table-hover">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>DNI</th>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Teléfono</th>
                        <th>Acciones</th>
                    </tr>
                </thead>

                <tbody>

                    @if (Model != null && Model.Count > 0)
                    {
                        @foreach (var p in Model)
                        {
                            <tr>
                                <td>@p.IdPropietario</td>
                                <td>@p.Dni</td>
                                <td>@p.Nombre</td>
                                <td>@p.Apellido</td>
                                <td>@p.Telefono</td>

                                <td>

                                    <a href="/Propietarios/Edit/@p.IdPropietario"
                                       class="btn btn-sm btn-warning">
                                        Editar
                                    </a>

                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <a href="/Propietarios/Delete/@p.IdPropietario"
                                           class="btn btn-sm btn-danger">
                                            Eliminar
                                        </a>
                                    }

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4">
                                No se encontraron propietarios.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- Paginación -->
        @if (totalPaginas > 1)
        {
            <nav>
                <ul class="pagination justify-content-center mb-0">

                    <!-- Anterior -->
                    <li class="page-item @(paginaActual <= 1 ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", new { busqueda = busqueda, pagina = paginaActual - 1 })">
                            Anterior
                        </a>
                    </li>


                    <!-- Números -->
                    @for (int i = 1; i <= totalPaginas; i++)
                    {
                        <li class="page-item @(i == paginaActual ? "active" : "")">
                            <a class="page-link"
                               href="@Url.Action("Index", new { busqueda = busqueda, pagina = i })">
                                @i
                            </a>
                        </li>
                    }


                    <!-- Siguiente -->
                    <li class="page-item @(paginaActual >= totalPaginas ? "disabled" : "")">
                        <a class="page-link"
                           href="@Url.Action("Index", new { busqueda = busqueda, pagina = paginaActual + 1 })">
                            Siguiente
                        </a>
                    </li>

                </ul>
            </nav>
        }

    </div>
</div>